```{}
read_github_parquets <- function(api_urls, token = Sys.getenv("GITHUB_PAT")) {
  
  lapply(seq_along(api_urls), function(i) {
    message("Downloading file ", i, "/", length(api_urls), "...")
    
    temp_file <- tempfile(fileext = ".parquet")
    
    httr::GET(
      api_urls[i],
      httr::add_headers(Authorization = paste("Bearer", token)),
      httr::add_headers(Accept = "application/vnd.github.raw"),
      httr::write_disk(temp_file, overwrite = TRUE)
    )
    
    df <- arrow::read_parquet(temp_file)
    unlink(temp_file)  # Clean up
    
    df
  })
}

# Usage
data_list <- read_github_parquets(files_list$url)

# Access individual dataframes
