```{}
download_github_files <- function(
      api_urls
    , dest_folder = "data"
    , token = Sys.getenv("GITHUB_PAT")) {
  
  # Create destination folder if it doesn't exist
  if (!dir.exists(dest_folder)) {
    dir.create(dest_folder, recursive = TRUE)
  }
  
  lapply(seq_along(api_urls), function(i) {
    message("Downloading file ", i, "/", length(api_urls), "...")
    
    # Get filename from API response
    response <- httr::GET(
      api_urls[i],
      httr::add_headers(Authorization = paste("Bearer", token))
    )
    
    file_info <- httr::content(response)
    filename <- file_info$name
    dest_path <- file.path(dest_folder, filename)
    
    # Download the actual file
    httr::GET(
      api_urls[i],
      httr::add_headers(Authorization = paste("Bearer", token)),
      httr::add_headers(Accept = "application/vnd.github.raw"),
      httr::write_disk(dest_path, overwrite = TRUE)
    )
    
    message("  Saved: ", dest_path)
    dest_path
  })
}
